# ==============================================================================
# PHANTOM Backend Environment Configuration (Example Template)
# ==============================================================================
# Copy to .env for local development. Never commit production secrets to Git!

# Application Environment (development, staging, production, test)
APP_ENV=development
APP_NAME=PHANTOM Video Intelligence Platform
APP_DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & JWT Secrets
# Generate in production using: openssl rand -hex 32
SECRET_KEY=phantom_insecure_development_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed Hosts & CORS
# Comma-separated list or JSON array of allowed origins
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Database Configuration (PostgreSQL 16 + PostGIS)
# Uses the application user phantom_app configured in Step 1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=phantom
POSTGRES_USER=phantom_app
POSTGRES_PASSWORD=phantom_app_secure_password_2026
DATABASE_URL=postgresql+asyncpg://phantom_app:phantom_app_secure_password_2026@localhost:5432/phantom
DATABASE_URL_SYNC=postgresql://phantom_app:phantom_app_secure_password_2026@localhost:5432/phantom

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Object Storage / S3 / MinIO Configuration (Future Modules Placeholder)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=phantom-evidence
S3_REGION=us-east-1
S3_USE_SSL=false

# Redis & Message Broker (Future Modules Placeholder)
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ==============================================================================
# YOLO AI Engine Configuration (YOLO26 with YOLOv8 Baseline Fallback)
# ==============================================================================
YOLO_MODEL_PATH=backend/app/ai/yolo26/models/yolo26.pt
YOLO_BASELINE_PATH=yolov8n.pt
YOLO_DEVICE=auto
YOLO_CONFIDENCE=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_INPUT_SIZE=640
YOLO_TARGET_CLASSES=PERSON,CAR,MOTORCYCLE,BUS,TRUCK,BICYCLE,OTHER_VEHICLE,LICENSE_PLATE
YOLO_INFERENCE_FPS=2.0
YOLO_ENABLE_TRACKING=true

