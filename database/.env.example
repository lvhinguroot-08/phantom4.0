# ==============================================================================
# PHANTOM Database Environment Configuration (Example)
# ==============================================================================
# Copy this file to .env before starting the database
# WARNING: Do NOT commit your production .env file to Git!

# PostgreSQL Host & Port
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=phantom

# Superuser / Admin Credentials (for migrations & DBA tasks only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_admin_password_in_production

# Application Database User (Used by FastAPI / Workers - Restricted DML privileges)
APP_DB_USER=phantom_app
APP_DB_PASSWORD=replace_with_secure_app_password_in_production

# Future Storage / Broker references (Step 2/3)
MINIO_ENDPOINT=http://localhost:9000
REDIS_URL=redis://localhost:6379/0
