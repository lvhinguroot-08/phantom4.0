# ==============================================================================
# PHANTOM // State-Wide Video Intelligence & Digital Forensics Platform
# Master Portable Environment Configuration (.env)
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Node Topology
NODE_ROLE=CENTRAL
REGIONAL_ZONE=CENTRAL_GUJARAT

# Service Bindings
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
REDIS_PORT=6379

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
ALLOWED_HOSTS=["*"]

# PostgreSQL / PostGIS Database Configuration
POSTGRES_HOST=phantom-db
POSTGRES_PORT=5432
POSTGRES_DB=phantom
POSTGRES_USER=postgres
POSTGRES_PASSWORD=phantom_dev_secure_password_2026

APP_DB_USER=phantom_app
APP_DB_PASSWORD=phantom_app_secure_password_2026

DATABASE_URL=postgresql+asyncpg://phantom_app:phantom_app_secure_password_2026@phantom-db:5432/phantom
DATABASE_URL_SYNC=postgresql://phantom_app:phantom_app_secure_password_2026@phantom-db:5432/phantom

# Redis In-Memory State & Cache
REDIS_URL=redis://phantom-redis:6379/0

# Security, Cryptography & JWT
SECRET_KEY=phantom_dev_secret_key_super_secure_for_hackathon_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
AI_WORKER_API_KEY=phantom_ai_worker_dev_key_2026

# Streaming Gateway & Video Ingestion Engine
STREAM_GATEWAY_CACHE_DIR=./var/hls_cache
STREAM_FFMPEG_BIN=ffmpeg
CAMERA_SOURCES_FILE=camera_sources.yaml
ENABLE_TEST_STREAM_FALLBACK=true
STREAM_GATEWAY_TIMEOUT_SECONDS=8
HLS_SEGMENT_DURATION_SECONDS=2
HLS_LIST_SIZE=4

# Stream Quality Profiles
STREAM_PROFILE_DEFAULT=MEDIUM
STREAM_LOW_RES=640x480
STREAM_LOW_FPS=15
STREAM_LOW_BITRATE_KBPS=500

STREAM_MEDIUM_RES=1280x720
STREAM_MEDIUM_FPS=20
STREAM_MEDIUM_BITRATE_KBPS=1500

STREAM_HIGH_RES=1920x1080
STREAM_HIGH_FPS=25
STREAM_HIGH_BITRATE_KBPS=4000

STREAM_BURST_RES=1920x1080
STREAM_BURST_FPS=30
STREAM_BURST_BITRATE_KBPS=6000

# AI Pipeline & Dynamic Sampling
AI_FRAME_INTERVAL_FPS=2.0
AI_BURST_FPS=25.0
AI_CONFIDENCE_THRESHOLD=0.35
AI_OCR_THRESHOLD=0.60
ANPR_MIN_CONFIDENCE=0.85
ALERT_DEDUPLICATION_SECONDS=60

# YOLO AI Engine Configuration (YOLO26 with YOLOv8 Baseline Fallback)
YOLO_MODEL_PATH=backend/app/ai/yolo26/models/yolo26.pt
YOLO_BASELINE_PATH=yolov8n.pt
YOLO_DEVICE=auto
YOLO_CONFIDENCE=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_INPUT_SIZE=640
YOLO_TARGET_CLASSES=PERSON,CAR,MOTORCYCLE,BUS,TRUCK,BICYCLE,OTHER_VEHICLE,LICENSE_PLATE
YOLO_INFERENCE_FPS=2.0
YOLO_ENABLE_TRACKING=true

# Rate Limiting & Safety
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_ANPR_INGEST_PER_SEC=100
RATE_LIMIT_GLOBAL_PER_MIN=600
